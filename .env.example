# Copy to .env.local. Never commit real keys.

# Request forms: emailed with Resend. If RESEND_API_KEY or FORMS_TO_EMAIL is
# missing in development, submissions are logged to the server console instead.
RESEND_API_KEY=
FORMS_TO_EMAIL=
FORMS_FROM_EMAIL=

# Public contact email shown on the Contact and legal pages. Leave empty to show
# no email anywhere. Intended production value: info@rafaelsupportfoundation.org
NEXT_PUBLIC_CONTACT_EMAIL=

# WhatsApp chat button: digits with country code, no + or spaces.
NEXT_PUBLIC_WHATSAPP_NUMBER=

NEXT_PUBLIC_SITE_URL=https://rafaelsupportfoundation.org

# Phase 2 (phase-2 branch only): Supabase. The URL and the public (publishable)
# key are safe for the browser. Never put the secret/service-role key in a
# NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Show Login / Account in the header (true or false). Leave empty or false on main.
NEXT_PUBLIC_ACCOUNTS_ENABLED=

# Phase 2: the app's own emails (booking and account emails).
# EMAIL_PROVIDER: smtp (Gmail bridge) now, resend later.
EMAIL_PROVIDER=
# Quote the value, for example "Rafael Support Foundation <sender@example.com>".
EMAIL_FROM=
# Where customer replies go. Change here later (for example to info@) with no code change.
REPLY_TO_EMAIL=
# Gmail SMTP: smtp.gmail.com, port 465. SMTP_PASS is the Google app password.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
# Warn in the admin Email health page when this many emails a day are reached.
EMAIL_DAILY_CAP=

# Phase 2 (M2 onward): Supabase SECRET key (service role). SERVER ONLY: set it in
# Vercel (mark Sensitive) and .env.local. Never put it in a NEXT_PUBLIC_ variable,
# never commit it. Used for two-step resets, recovery codes, audit/email logging
# and the database rate limiter.
SUPABASE_SERVICE_ROLE_KEY=
